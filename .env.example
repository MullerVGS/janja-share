# Obrigatórios. Gere com: openssl rand -hex 32 (a chave, -hex 16)
POSTGRES_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sinalização do SFU como o navegador a alcança. Atrás de TLS: wss://sfu.exemplo.com
LIVEKIT_URL=ws://localhost:7880

# ── Opcionais ─────────────────────────────────────────────────────────────────
# Rede do reverse proxy, quando ele alcança o app pelo nome do container.
#REDE_DA_BORDA=rede-do-proxy
#REDE_DA_BORDA_EXTERNA=true

# Onde cada porta escuta no host; o padrão só abre no loopback.
#BIND_APP=127.0.0.1
#PORTA_APP=3000
#BIND_DB=127.0.0.1
#PORTA_DB=5443
#BIND_LIVEKIT=127.0.0.1
#PORTA_LIVEKIT=7880

# Mídia: pública sempre, é WebRTC.
#PORTA_MIDIA_TCP=7881
#PORTA_MIDIA_UDP=7882

# Nomes do projeto e dos containers.
#PROJETO=janja-share
#NOME=janja-share

# SFU na sua máquina: anuncie o loopback em vez de descobrir o IP externo.
#SFU_IP_EXTERNO=false
#SFU_IP=127.0.0.1
